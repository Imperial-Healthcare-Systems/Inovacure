# Inovacure — environment template. Copy to .env.local and fill in.
# .env.local is gitignored; NEVER commit real keys. This file holds placeholders only.

# ── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project → Project Settings → API.
# URL + anon key are safe to expose to the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key BYPASSES RLS — server-only. Never prefix with NEXT_PUBLIC,
# never put it in public/, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin console (existing) ────────────────────────────────────────────────
# Gates the /admin route (404 unless "true"). Leave unset in production until
# real server-side auth exists.
ADMIN_ENABLED=
# SHA-256 of the admin password (not the plaintext). See docs.
ADMIN_PASS_HASH=

# ── Storefront (existing) ───────────────────────────────────────────────────
# Un-dormants /store when "true". Leave unset to keep it dormant (404).
COMMERCE_ENABLED=
